#!/bin/bash
# Everything an agent may do to the staging stack, and nothing that reaches production.
#
#     deylee-staging <command> [args]      (run on the host that runs compose)
#
# Installed root-owned, outside any checkout, with the compose file beside it:
#
#     sudo install -m 755 server/staging/deylee-staging /usr/local/bin/
#     sudo install -D -m 644 server/staging/compose.yaml /usr/local/share/deylee-staging/compose.yaml
#     sudo install -m 644 server/staging/staging.slice /etc/systemd/system/ && sudo systemctl daemon-reload
#
# Root-owned is the point. Staging builds from production's checkout, /opt/deylee, which is
# writable without sudo; if this script or the compose file came from there, a commit could
# rename a container to production's and `up` would replace it. So only the application's
# code comes from the checkout. What runs, under which names, with which volumes, is fixed
# here, and changing it takes sudo.
#
# Sharing the checkout means staging runs whatever production's checkout holds — main. This
# script never runs git: checking a branch out there would change production's files, so
# testing a branch on staging needs a checkout of its own.
#
# Commands:
#   init                first run: database up, migrations, the API role
#   deploy              rebuild the API from the checkout, migrate, restart the API
#   up [--tunnel]       start the stack; the staging tunnel only when asked
#   down                stop it (the database volume is kept)
#   restart [service]   default api
#   migrate             apply the checkout's migrations to the staging database
#   psql [args...]      psql as the owner, inside the staging database
#   logs [service] [n]  default api, 200 lines
#   ps | health
#   reset-db            delete staging's database and rebuild it from the migrations
set -euo pipefail

# Fixed, not read from the environment: the command allowed to drive staging must not be
# able to point itself somewhere else.
CHECKOUT=/opt/deylee
COMPOSE=/usr/local/share/deylee-staging/compose.yaml
PROD_ENV=$CHECKOUT/server/.env
PROJECT=deylee-staging
VOLUME=${PROJECT}_staging-db
DB=deylee-staging-db

cd "$CHECKOUT"
dc() { docker compose -p "$PROJECT" -f "$COMPOSE" --project-directory "$CHECKOUT" "$@"; }
value() { grep -E "^$1=" "$2" 2>/dev/null | head -1 | cut -d= -f2- | tr -d "\"'"; }

# Refuse to run staging with any of production's secrets. A shared signing key makes
# tokens valid on both; a shared tunnel token splits production's traffic onto staging.
guard_secrets() {
  local key
  for key in SESSION_JWT_PRIVATE_KEY_B64 TUNNEL_TOKEN; do
    local mine; mine=$(value "$key" server/.env.staging)
    if [ -n "$mine" ] && [ "$mine" = "$(value "$key" "$PROD_ENV")" ]; then
      echo "refusing: server/.env.staging reuses production's $key" >&2
      exit 1
    fi
  done
}

# Migrations run in a throwaway container on staging's network only, so whatever a branch's
# migrate.sh does, the only database it can reach is staging's.
migrate() {
  docker run --rm --network "${PROJECT}_default" \
    --env-file server/.env.staging.db -v "$CHECKOUT/server:/server:ro" \
    postgres:17 bash -c 'PGPASSWORD=$POSTGRES_PASSWORD PSQL="psql -h db -U postgres -d postgres" bash /server/scripts/migrate.sh'
}

api_role() {
  local url password
  url=$(value DEYLEE_DB_URL server/.env.staging)
  password=$(printf '%s' "$url" | sed -E 's#^[a-z]+://[^:]+:([^@]+)@.*#\1#')
  docker exec -i "$DB" psql -U postgres -d postgres -X -q -v ON_ERROR_STOP=1 \
    -v pw="$password" <<'SQL'
select format('create role deylee_api_user login password %L', :'pw')
 where not exists (select 1 from pg_roles where rolname = 'deylee_api_user') \gexec
select format('alter role deylee_api_user password %L', :'pw') \gexec
grant deylee_api to deylee_api_user;
SQL
}

command=${1:-}
[ $# -gt 0 ] && shift
case "$command" in
  init)
    guard_secrets
    dc up -d --wait db
    migrate
    api_role
    dc up -d --wait api
    ;;
  deploy)
    guard_secrets
    git log --oneline -1
    dc build api
    migrate
    dc up -d --no-deps --wait api
    ;;
  up)
    guard_secrets
    if [ "${1:-}" = --tunnel ]; then dc --profile tunnel up -d --wait; else dc up -d --wait; fi
    ;;
  down) dc --profile tunnel down ;;
  restart) dc restart "${1:-api}" ;;
  migrate) migrate ;;
  psql) docker exec -i "$DB" psql -U postgres -d postgres "$@" ;;
  logs) dc logs --tail "${2:-200}" "${1:-api}" ;;
  ps) dc --profile tunnel ps ;;
  health) curl -s --max-time 5 http://127.0.0.1:8090/health; echo ;;
  reset-db)
    dc --profile tunnel down
    docker volume rm "$VOLUME"
    "$0" init
    ;;
  *)
    sed -n '/^# Commands:/,/^set -euo/p' "$0" | sed '$d' >&2
    exit 2
    ;;
esac
