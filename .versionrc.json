{
  "header": "# Changelog\n\nEvery entry is generated from Conventional Commit messages — see CLAUDE.md.\nThis project follows [Semantic Versioning](https://semver.org). While it is pre-1.0 the\nSQLite schema may still change, so a minor bump can carry a migration.\n",
  "types": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "hidden": true },
    { "type": "style", "hidden": true },
    { "type": "test", "hidden": true },
    { "type": "build", "hidden": true },
    { "type": "ci", "hidden": true },
    { "type": "chore", "hidden": true }
  ],
  "commitUrlFormat": "https://github.com/faizrazadec/dayly/commit/{{hash}}",
  "compareUrlFormat": "https://github.com/faizrazadec/dayly/compare/{{previousTag}}...{{currentTag}}",
  "issueUrlFormat": "https://github.com/faizrazadec/dayly/issues/{{id}}",
  "releaseCommitMessageFormat": "chore(release): {{currentTag}}",
  "tagPrefix": "v",
  "bumpFiles": [{ "filename": "package.json", "type": "json" }],
  "packageFiles": [{ "filename": "package.json", "type": "json" }]
}
