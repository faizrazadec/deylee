# SwiftPM build output and the assembled app bundle.
.build/
dist/
*.xcodeproj
.swiftpm/

# Local time-tracking data.
# Deylee's real database lives in ~/Library/Application Support/deylee, never in the
# repo — but a backup taken through Settings, or an export written to the project
# folder, would otherwise be committed. This is personal working-hours data; keep it
# out of version control.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
deylee-backup-*.sqlite
deylee-*_to_*.csv
deylee-*_to_*.json

# Backend secrets. The Supabase service_role key bypasses row-level security
# entirely — it is the one credential that can read every customer's hours. It
# belongs in a local .env and never in a commit, a client binary, or a log.
.env
.env.*
!.env.example
supabase/.temp/

# Logs
*.log
logs/

# Editors
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code. `.claude/` holds per-machine state such as tool permissions; CLAUDE.md
# is the agent rules file. Both are kept local, so the commit convention they describe
# is enforced by the .husky/commit-msg hook rather than by this file being present.
.claude/
CLAUDE.md

# OS
.DS_Store
.DS_Store?
._*
Desktop.ini

# The 1024px icon master in macos/Resources is deliberately NOT ignored: it is a
# packaging input that make-app.sh turns into AppIcon.icns, so a clean checkout can
# build a bundle without regenerating anything.
