# Deylee backend — environment template.
#
# Copy this file to `.env` and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is not, so it must never contain a real
# value. Keep the two in step: a variable added here without a note about where
# it comes from is a variable the next person cannot fill in.

# ---------------------------------------------------------------------------
# Google Sign-In.
#
# Google is the identity provider directly, and only ever tells us *who* someone
# is — turning that into a session is this API's job, which is what the SESSION_
# keys below are for.
#
# A separate OAuth client is required per platform, because Google stamps a
# different `aud` claim on each one. The API keeps the full list of client ids it
# will accept and rejects everything else, so a token minted for one platform
# cannot be replayed from another.
#
# Only web and desktop clients have secrets. Native clients use PKCE and must
# never carry one — a secret shipped inside an app is not a secret.
# ---------------------------------------------------------------------------

# Google Auth Platform -> Clients. The iOS client type covers macOS.
#
# The Mac app runs the whole flow itself: it opens Google in an
# ASWebAuthenticationSession, completes the PKCE exchange, and sends only the
# resulting ID token here. The API's job is to verify that token and swap it for
# a session, so there is no redirect through this server and no secret involved.
GOOGLE_CLIENT_ID_IOS=

# Not needed while macOS is the only client. Each is filled in when that platform
# is actually built, and every non-empty one becomes an accepted audience.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_DESKTOP=
GOOGLE_CLIENT_SECRET_DESKTOP=

# Where Google returns the browser. Only the web flow redirects through the API;
# the Mac app is handed back through its own reversed-client-id URL scheme, which
# is derived from GOOGLE_CLIENT_ID_IOS rather than configured separately.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/google/callback

# Fixed by Google. Held in config so a test can point at a fake issuer.
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Restrict sign-in to one Google Workspace domain by checking the `hd` claim.
# Empty means any Google account. The `hd` request parameter is only a hint to
# the account chooser, so this server-side check is the one that counts.
GOOGLE_ALLOWED_HD=

# ---------------------------------------------------------------------------
# Session tokens.
#
# Google's ID token lasts about an hour and is not a session. The API exchanges
# it once for its own ES256 access token plus a long-lived refresh token, so the
# clients never re-prompt and never hold a Google credential.
#
# Asymmetric so the signing half stays on the API, and anything verifying only
# needs the public half.
# ---------------------------------------------------------------------------

# Base64 of a PEM P-256 keypair. Regenerate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out priv.pem
#   openssl ec -in priv.pem -pubout -out pub.pem
SESSION_JWT_PRIVATE_KEY_B64=
SESSION_JWT_PUBLIC_KEY_B64=

SESSION_JWT_ISSUER=https://api.deylee.app
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=90
# How long the refresh token just replaced may be traded again without reading as
# theft. Covers two requests racing on one token and an app killed before it saved
# the rotated pair. 0 revokes the session on any second use.
REFRESH_TOKEN_REUSE_INTERVAL_SECONDS=10

# ---------------------------------------------------------------------------
# The database.
#
# Postgres runs beside the API in compose (the `db` service), with its superuser
# password in server/db.env rather than here, so the API never holds a login that
# skips row-level security:
#
#   printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 32)" > server/db.env
#
# The API connects as deylee_api_user, which is granted only the deylee_api role:
# select, insert and update on the syncable tables, and deliberately no delete,
# because rows are tombstoned rather than removed. The policies bind for real — the
# API refuses to start as a role that bypasses them.
#
# Create the login once, after `server/scripts/migrate.sh`, so no password reaches
# this repository:
#   docker exec -i deylee-db psql -U postgres -c \
#     "create role deylee_api_user login password '<generated>'; grant deylee_api to deylee_api_user;"
# ---------------------------------------------------------------------------

DEYLEE_DB_URL=postgresql://deylee_api_user:<generated>@db:5432/postgres

# `require` (the default) or `disable`. Compose keeps the database on a private
# network on the same host with no published port, so there is nothing to encrypt
# against: `disable`. A database on another machine needs `require` and the CA
# that signed its certificate in DEYLEE_DB_CA_CERT; the API refuses TLS it cannot
# verify.
DEYLEE_DB_TLS=disable
DEYLEE_DB_CA_CERT=

# The owner login, for the smoke scripts only — they create and clean up probe
# rows the restricted login cannot touch. Never the API's DEYLEE_DB_URL.
DEYLEE_DB_OWNER_URL=

# ---------------------------------------------------------------------------
# Resend — the sign-up code
#
# Signing up no longer creates an account outright. The request is parked, a
# six-digit code is mailed, and the account is written only once that code comes
# back. Without these three the API refuses to start, because a deployment that
# cannot send mail is one where nobody can make an account.
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# The From header. The domain must be verified in Resend or every send is
# refused, e.g. Deylee <no-reply@deylee.app>
RESEND_FROM=

# Id or alias of the published Resend template. It takes one variable, `otp`,
# which is where the six digits land. Renaming that variable in the dashboard
# sends mail with an empty code and nothing here fails — so do not.
RESEND_OTP_TEMPLATE_ID=

# How long a code stays good, and how long before another may be requested.
# The second is what stops the endpoint being a way to post mail to any inbox.
SIGNUP_CODE_TTL_SECONDS=600
SIGNUP_CODE_RESEND_SECONDS=60

# ---------------------------------------------------------------------------
# The marketing site
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API cross-origin. Only /v1/contact needs
# it — the site is a static export on another host, so its contact form is a
# cross-origin POST and a browser will not send one without an allow-origin
# header coming back.
#
# An allow-list, never `*`, and credentials stay off: this grants the site the
# ability to post a form and grants nobody the ability to ride a session.
# Comma-separated, for running the site locally against a local API.
#
# Defaults to the deployed site when unset, so a deployment that forgets it
# still works — the failure would otherwise only show in a browser console.
WEB_ORIGIN=https://deylee.faizraza.me

# ---------------------------------------------------------------------------
# Updates and the tunnel (compose.yaml)
# ---------------------------------------------------------------------------
# Where the API serves the signed Sparkle appcast and update archives, as
# /updates/*. compose mounts /srv/deylee-updates here read-only. Unset, nothing
# is served and every installed copy of the app loses its update feed — and no
# health check notices.
DEYLEE_UPDATES_DIR=/srv/updates

# Read by the `tunnel` service: `cloudflared tunnel run` takes its credentials
# from TUNNEL_TOKEN. Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels.
# Without it the tunnel never connects and the public URL answers 530.
TUNNEL_TOKEN=
