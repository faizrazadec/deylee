# Deylee backend — environment template.
#
# Copy this file to `.env` and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored; this template is not, so it must never contain a real
# value. Keep the two in step: a variable added here without a note about where
# it comes from is a variable the next person cannot fill in.
#
# This project uses Supabase's current API keys (publishable / secret) and
# asymmetric JWT signing keys, not the legacy anon / service_role / HS256 shared
# secret. The legacy tab in the dashboard is deliberately unused; nothing here
# should ever be filled from it.

# ---------------------------------------------------------------------------
# Public. These ship inside the Mac app, the iOS app and the web bundle. They
# are meant to be readable by anyone holding the binary, and row-level security
# is what keeps that safe. Do not add a secret to this section.
# ---------------------------------------------------------------------------

# Settings -> General. The short slug in your project's URL.
SUPABASE_PROJECT_REF=

# Settings -> API. Looks like https://<project-ref>.supabase.co
SUPABASE_URL=

# Settings -> API Keys -> Publishable and secret API keys. Starts with
# `sb_publishable_`. Supabase states outright that this one is safe to share, so
# long as RLS is enabled on every table — which is exactly why the schema turns
# RLS on in the same migration that creates each table, never in a later one.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Secret. Server-side only.
#
# The secret key bypasses row-level security completely. It is the one
# credential that can read every customer's working hours, so it never belongs
# in a client binary, a log line, a screenshot, or a chat message. If one of
# these leaks, rotate it in the dashboard rather than hoping.
# ---------------------------------------------------------------------------

# Settings -> API Keys -> Publishable and secret API keys. Starts with `sb_secret_`.
SUPABASE_SECRET_KEY=

# Settings -> Database -> Connection string, URI form. Used by the CLI to run
# migrations. Prefer the pooler host; the password is the database password you
# set when the project was created, not your Supabase account password.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Token verification.
#
# The project signs access tokens with an asymmetric key (ECC P-256), so the
# sync API verifies them against the public key published here and holds no
# signing secret of its own. That is the whole point of the asymmetric setup: a
# leaked API server cannot mint tokens, only check them.
#
# Rotation is handled by key id — the JWKS endpoint serves both the current and
# the previous key while old tokens expire, so verification must select on the
# token's `kid` rather than assuming a single key.
# ---------------------------------------------------------------------------

# https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# ---------------------------------------------------------------------------
# Google Sign-In.
#
# Google is the identity provider directly; Supabase Auth is not in the loop.
# Google therefore only ever tells us *who* someone is — turning that into a
# session is this API's job, which is what the SESSION_ keys below are for.
#
# A separate OAuth client is required per platform, because Google stamps a
# different `aud` claim on each one. The API keeps the full list of client ids it
# will accept and rejects everything else, so a token minted for one platform
# cannot be replayed from another.
#
# Only web and desktop clients have secrets. Native clients use PKCE and must
# never carry one — a secret shipped inside an app is not a secret.
# ---------------------------------------------------------------------------

# Google Auth Platform -> Clients. The iOS client type covers macOS.
#
# The Mac app runs the whole flow itself: it opens Google in an
# ASWebAuthenticationSession, completes the PKCE exchange, and sends only the
# resulting ID token here. The API's job is to verify that token and swap it for
# a session, so there is no redirect through this server and no secret involved.
GOOGLE_CLIENT_ID_IOS=

# Not needed while macOS is the only client. Each is filled in when that platform
# is actually built, and every non-empty one becomes an accepted audience.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_DESKTOP=
GOOGLE_CLIENT_SECRET_DESKTOP=

# Where Google returns the browser. Only the web flow redirects through the API;
# the Mac app is handed back through its own reversed-client-id URL scheme, which
# is derived from GOOGLE_CLIENT_ID_IOS rather than configured separately.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/google/callback

# Fixed by Google. Held in config so a test can point at a fake issuer.
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Restrict sign-in to one Google Workspace domain by checking the `hd` claim.
# Empty means any Google account. The `hd` request parameter is only a hint to
# the account chooser, so this server-side check is the one that counts.
GOOGLE_ALLOWED_HD=

# ---------------------------------------------------------------------------
# Session tokens.
#
# Google's ID token lasts about an hour and is not a session. The API exchanges
# it once for its own ES256 access token plus a long-lived refresh token, so the
# clients never re-prompt and never hold a Google credential.
#
# Asymmetric for the same reason the Supabase setup was: the signing half stays
# on the API, and anything verifying only needs the public half.
# ---------------------------------------------------------------------------

# Base64 of a PEM P-256 keypair. Regenerate with:
#   openssl ecparam -genkey -name prime256v1 -noout -out priv.pem
#   openssl ec -in priv.pem -pubout -out pub.pem
SESSION_JWT_PRIVATE_KEY_B64=
SESSION_JWT_PUBLIC_KEY_B64=

SESSION_JWT_ISSUER=https://api.deylee.app
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=90

# ---------------------------------------------------------------------------
# The API's own database login.
#
# SUPABASE_DB_URL connects as `postgres`, which owns every table and therefore
# bypasses row-level security outright. That account is for migrations and
# nothing else — an API holding it would have every policy silently skipped, and
# one forgotten WHERE clause would return another customer's hours.
#
# This login has no such exemption. It is granted only the deylee_api role:
# select, insert and update on the syncable tables, and deliberately no delete,
# because rows are tombstoned rather than removed. The policies bind for real.
#
# The API must issue `set local app.user_id = '<id>'` inside each request's
# transaction; without it the policies match nothing and every query reads empty.
#
# Create the login out of band so no password reaches this repository:
#   create role deylee_api_user login password '<generated>';
#   grant deylee_api to deylee_api_user;
# ---------------------------------------------------------------------------

DEYLEE_DB_URL=

# Path to the CA certificate that signed the database server's certificate.
#
# Supabase signs its direct Postgres endpoint with its own CA, not a publicly
# trusted one, so a verifying client cannot authenticate it against the system
# trust store. Left empty the connection is still encrypted, but nothing proves
# the far end is your database — the API logs a warning saying so on every boot.
#
# Download it from Settings -> Database in the dashboard and point this at the
# file. Encrypted and authenticated is the state to ship in.
DEYLEE_DB_CA_CERT=

# `require` (default) or `disable`. Only ever `disable` for a local development
# database on a private network.
DEYLEE_DB_TLS=require

# ---------------------------------------------------------------------------
# Resend — the sign-up code
#
# Signing up no longer creates an account outright. The request is parked, a
# six-digit code is mailed, and the account is written only once that code comes
# back. Without these three the API refuses to start, because a deployment that
# cannot send mail is one where nobody can make an account.
# ---------------------------------------------------------------------------

RESEND_API_KEY=

# The From header. The domain must be verified in Resend or every send is
# refused, e.g. Deylee <no-reply@deylee.app>
RESEND_FROM=

# Id or alias of the published Resend template. It takes one variable, `otp`,
# which is where the six digits land. Renaming that variable in the dashboard
# sends mail with an empty code and nothing here fails — so do not.
RESEND_OTP_TEMPLATE_ID=

# How long a code stays good, and how long before another may be requested.
# The second is what stops the endpoint being a way to post mail to any inbox.
SIGNUP_CODE_TTL_SECONDS=600
SIGNUP_CODE_RESEND_SECONDS=60

# ---------------------------------------------------------------------------
# The marketing site
# ---------------------------------------------------------------------------
# Browser origins allowed to call the API cross-origin. Only /v1/contact needs
# it — the site is a static export on another host, so its contact form is a
# cross-origin POST and a browser will not send one without an allow-origin
# header coming back.
#
# An allow-list, never `*`, and credentials stay off: this grants the site the
# ability to post a form and grants nobody the ability to ride a session.
# Comma-separated, for running the site locally against a local API.
#
# Defaults to the deployed site when unset, so a deployment that forgets it
# still works — the failure would otherwise only show in a browser console.
WEB_ORIGIN=https://deylee.faizraza.me
