#!/bin/sh
# Conventional Commits, enforced without Node.
#
# This used to shell out to `npx commitlint`, which meant an npm install and a
# node_modules tree in a repository that is otherwise pure Swift. The rules are
# few and stable enough to check directly, so the guard outlives the toolchain
# it was borrowed from.
#
# Mirrors the old commitlint config: the conventional preset, the scope list from
# the architecture, a 72-character header and 100-character body lines.

msg_file="$1"

fail() {
	printf '\n\033[31mx\033[0m %s\n' "$1" >&2
	shift
	for line in "$@"; do printf '  %s\n' "$line" >&2; done
	printf '\n  See CLAUDE.md for the full rules.\n\n' >&2
	exit 1
}

# git strips comment lines before storing the message, so ignore them here too,
# then drop the leading blank lines an editor may have left behind.
header=$(grep -v '^#' "$msg_file" | sed '/./,$!d' | head -n 1)

[ -n "$header" ] || fail "The commit message is empty."

# A merge, revert or fixup header is generated by git and is not ours to shape.
case "$header" in
Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

types='feat|fix|perf|refactor|docs|test|chore|build|ci|style|revert'
scopes='mac|db|domain|timer|tray|platform|windows|panel|mini|history|settings|updater|icons|build|deps|docs|ci'

echo "$header" | grep -Eq "^($types)(\(($scopes)\))?!?: .+" || fail \
	"The header is not a conventional commit." \
	"Got:      $header" \
	"Expected: <type>(<optional scope>): <description>" \
	"Types:    $(echo "$types" | tr '|' ' ')" \
	"Scopes:   $(echo "$scopes" | tr '|' ' ')"

[ ${#header} -le 72 ] || fail \
	"The header is ${#header} characters; the limit is 72." "Got: $header"

# The description becomes the changelog entry, so its shape is not cosmetic.
subject=${header#*: }

case "$subject" in
*.) fail "The description must not end with a full stop." "Got: $subject" ;;
esac

case "$(printf '%s' "$subject" | cut -c1)" in
[A-Z]) fail "The description must start in lower case." "Got: $subject" ;;
esac

# An over-long body line is only a warning in most setups. Here it fails, because
# a badly wrapped changelog entry is never gone back to and fixed.
line_no=0
while IFS= read -r line; do
	line_no=$((line_no + 1))
	[ "$line_no" -eq 1 ] && continue
	case "$line" in
	'#'*) continue ;;
	# A bare URL cannot be wrapped, so it is the one exception.
	*http://*|*https://*) continue ;;
	esac
	[ ${#line} -le 100 ] || fail \
		"Body line $line_no is ${#line} characters; the limit is 100." "Got: $line"
done <"$msg_file"

if grep -Eqi '^(co-authored-by|generated (with|by)).*(claude|copilot|chatgpt|gpt|cursor| ai\b)' "$msg_file"; then
	fail "AI attribution trailers are not used in this repository."
fi

exit 0
