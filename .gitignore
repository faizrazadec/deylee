# Dependencies
node_modules/
# node-gyp's staging directory during the better-sqlite3 rebuild.
node_modules/.tmp/

# Build output
# `out/` is unanchored on purpose: electron-vite writes to ./out, and a stray
# renderer build can land in src/renderer/out if outDir is ever overridden.
out/
dist/
release/
*.tsbuildinfo
.vite/

# Native module build artefacts (better-sqlite3 is rebuilt from source per Electron ABI)
build/Release/
build/Debug/
prebuilds/
*.node

# Test / coverage
coverage/
.nyc_output/

# Local time-tracking data.
# Dayly's real database lives in app.getPath('userData'), never in the repo — but a
# backup taken through Settings, or an export written to the project folder, would
# otherwise be committed. This is personal working-hours data; keep it out of
# version control.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
dayly-backup-*.sqlite
dayly-*_to_*.csv
dayly-*_to_*.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Environment
.env
.env.*
!.env.example

# Editors
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code. `.claude/` holds per-machine state such as tool permissions; CLAUDE.md
# is the agent rules file. Both are kept local, so the commit convention they describe
# is enforced by commitlint + the husky commit-msg hook rather than by this file being
# present — see commitlint.config.mjs, which IS tracked.
.claude/
CLAUDE.md

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Generated icons are deliberately NOT ignored.
# `npm run icons` regenerates build/icon.png and resources/tray/**, but they are
# packaging inputs and stay committed, so a clean checkout can build a release
# without running the generator first.
